#!/usr/bin/env bash
#
# Hook de proteção do MAPEmunicipios-ETL.
#
# Instalar com:  bash tools/hooks/instalar.sh
#
# Bloqueia duas coisas que já quase aconteceram neste repositório:
#   1. commitar a árvore legada mape_municipios/ (~18 GB)
#   2. commitar qualquer arquivo acima do limiar de tamanho
#
# Para contornar deliberadamente:  git commit --no-verify

set -euo pipefail

# Achado 84: o limiar estava duplicado — 20 aqui e qa.max_mb_versionavel no
# YAML — e os dois podiam divergir sem que nada avisasse. Agora o hook LE o
# YAML, com o literal como último recurso para o caso de o R não estar
# disponível no ambiente do commit.
#
# O `|| LIMIAR_MB=""` não é enfeite: com `set -e` (linha 13), uma atribuição
# cujo lado direito é substituição de comando herda o código de saída do
# comando, e um Rscript que falha — R ausente, `yaml` não instalado, hook
# rodando de um worktree sem config/parametros.yml — derrubava o hook inteiro
# ali mesmo, em silêncio e antes de olhar arquivo nenhum. O fallback das linhas
# seguintes era, por isso, inalcançável. O `|| ...` isenta a atribuição do
# `set -e` (é o lado esquerdo de uma lista OR) e devolve o controle ao `case`,
# que é quem decide o limiar quando a leitura não deu certo.
LIMIAR_MB=$(Rscript -e 'cat(yaml::read_yaml("config/parametros.yml")$qa$max_mb_versionavel)' 2>/dev/null) || LIMIAR_MB=""
case "$LIMIAR_MB" in
  ''|*[!0-9]*) LIMIAR_MB=20 ;;
esac
LIMIAR_BYTES=$((LIMIAR_MB * 1024 * 1024))
erros=0

# Arquivos adicionados ou modificados neste commit.
#
# Achado 61: sem -z, o git aplica core.quotepath e devolve caminhos com acento
# escapados e entre aspas ("fontes/mun\303\255cipio.parquet"), que o teste
# [ -f ] não encontra — e o arquivo passava. O -z com read -d '' elimina o
# escape de uma vez.
arquivos=()
while IFS= read -r -d '' arquivo; do
  arquivos+=("$arquivo")
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "${#arquivos[@]}" -eq 0 ]; then
  exit 0
fi

for arquivo in "${arquivos[@]}"; do
  [ -z "$arquivo" ] && continue

  # 1. Árvore legada
  case "$arquivo" in
    mape_municipios/*)
      echo "ERRO: $arquivo pertence à árvore legada."
      echo "      mape_municipios/ tem ~18 GB e nunca deve ser versionada."
      erros=$((erros + 1))
      continue
      ;;
  esac

  # 2. Tamanho
  #
  # Achado 61: medir o arquivo na ÁRVORE DE TRABALHO deixava passar o caso em
  # que ele é removido (ou truncado) depois do `git add` — o objeto grande já
  # está no índice e vai para o commit, mas [ -f ] falha e o `continue` deixava
  # passar. Medir o OBJETO do índice mede o que de fato será commitado, e não
  # depende de o arquivo existir nem de ser um arquivo regular.
  bytes=$(git cat-file -s "$(git rev-parse ":$arquivo" 2>/dev/null)" 2>/dev/null)
  case "$bytes" in
    ''|*[!0-9]*) continue ;;
  esac
  if [ "$bytes" -gt "$LIMIAR_BYTES" ]; then
    mb=$((bytes / 1024 / 1024))
    echo "ERRO: $arquivo tem ${mb} MB, acima do limiar de ${LIMIAR_MB} MB."
    echo "      Ver plano/migracao-etl/03-versionamento-qa.md, seção 10.2."
    echo "      Arquivos grandes vão para release do GitHub, não para o git."
    erros=$((erros + 1))
  fi
done

if [ "$erros" -gt 0 ]; then
  echo ""
  echo "Commit bloqueado: $erros problema(s). Use --no-verify para forçar."
  exit 1
fi

exit 0
